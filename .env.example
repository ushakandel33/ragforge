# Primary provider: Google Gemini (free tier via https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Fallback provider: Groq (free tier via https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# App
APP_TEMPERATURE=0.4
APP_TOP_P=0.9
RATE_LIMIT_PER_MINUTE=20
CACHE_TTL_SECONDS=3600
MAX_AGENT_STEPS=5
AGENT_EVIDENCE_LIMIT=6
AGENT_HISTORY_LIMIT=8
VECTOR_DB_PATH=./data/chroma_db
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Local open-source model (vLLM) - only used if LOCAL_MODEL_ENABLED=true
LOCAL_MODEL_ENABLED=false
LOCAL_MODEL_BASE_URL=http://localhost:8001/v1
LOCAL_MODEL_NAME=mistralai/Mistral-7B-Instruct-v0.2
